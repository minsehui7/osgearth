#ifndef OSGEARTH_CESIUM_HYPERTERRAIN_BRIDGE_H
#define OSGEARTH_CESIUM_HYPERTERRAIN_BRIDGE_H

#include "Export"
#include "HyperTerrainTypes"

#include <osg/Group>
#include <osg/Vec3f>

#include <memory>

namespace osgEarth {
namespace Cesium {

class HyperTerrainPrepareRendererResources;

/**
 * Owns cesium-native Tilesets for the HyperTerrain osgEarth engine plugin.
 * All cesium-native objects live inside osgEarthCesium.dll.
 */
class OSGEARTHCESIUM_EXPORT HyperTerrainBridge {
public:
    explicit HyperTerrainBridge(osg::Group* tileGroup);
    ~HyperTerrainBridge();

    HyperTerrainBridge(const HyperTerrainBridge&) = delete;
    HyperTerrainBridge& operator=(const HyperTerrainBridge&) = delete;

    bool initialize(const HyperTerrainInitOptions& options);

    void updateFrame(const HyperTerrainViewParams& viewParams, bool tilesetReady);

    /// compositingSlot: shader u_overlayTex index (0..3). -1 = legacy registration order.
    void addImageryOverlay(RasterOverlayPtr overlay, int compositingSlot = -1);
    void removeImageryOverlay(RasterOverlayPtr overlay);
    void setImageryOverlayAlpha(RasterOverlayPtr overlay, float alpha);
    void setTmsImageryExposure(float exposure);
    void setTerrainBaseColor(const osg::Vec3f& rgb);

    bool hasPrimaryTileset() const;

private:
    struct Impl;
    std::unique_ptr<Impl> _impl;
};

} // namespace Cesium
} // namespace osgEarth

#endif // OSGEARTH_CESIUM_HYPERTERRAIN_BRIDGE_H
