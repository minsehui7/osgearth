#ifndef OSGEARTH_CESIUM_TILESETNODE_H
#define OSGEARTH_CESIUM_TILESETNODE_H

#include "Export"
#include "PrepareRenderResources"
#include <osg/Group>
#include <osgEarth/Terrain>

#include <atomic>
#include <condition_variable>
#include <deque>
#include <memory>
#include <mutex>
#include <thread>
#include <unordered_set>
#include <vector>

namespace osgEarth { class Map; }

namespace osgEarth { namespace Cesium
{
    using namespace osgEarth;

    struct ClampWorkResult;

    class OSGEARTHCESIUM_EXPORT CesiumTilesetNode : public osg::Group
    {
    public:
        CesiumTilesetNode(unsigned int assetID, const std::string& server = "", const std::string& token = "", float maximumScreenSpaceError = 16.0f, std::vector<int> overlays = std::vector<int>(), const TilesetRenderStyleOptions& renderStyle = TilesetRenderStyleOptions(), int minimumRenderableLevel = -1);
        CesiumTilesetNode(const std::string& url, const std::string& server = "", const std::string& token = "", float maximumScreenSpaceError = 16.0f, std::vector<int> overlays = std::vector<int>(), const TilesetRenderStyleOptions& renderStyle = TilesetRenderStyleOptions(), int minimumRenderableLevel = -1);

        ~CesiumTilesetNode();

        void traverse(osg::NodeVisitor& nv) override;

        osg::BoundingSphere computeBound() const override;

        float getMaximumScreenSpaceError() const;
        void setMaximumScreenSpaceError(float maximumScreenSpaceError);

        bool getForbidHoles() const;
        void setForbidHoles(bool forbidHoles);

        int getMinimumRenderableLevel() const;
        void setMinimumRenderableLevel(int level);

        void invalidateClampedTiles();

        // Called by TerrainCallbackAdapter when terrain tiles load/change.
        void onTileUpdate(const TileKey& key, osg::Node* tile, TerrainCallbackContext& context);

    private:
        osg::Group* tileParent();
        void ensureClampThread();
        void clampWorkerLoop();
        void applyClampResults();
        void installTerrainCallback();

        void* _tileset = nullptr;
        int _minimumRenderableLevel = -1;
        bool _clampToGround = false;

        // Async CPU clamping -- all ElevationQuery work happens on _clampThread.
        std::mutex _clampMutex;
        std::condition_variable _clampCV;
        std::deque<osg::ref_ptr<osg::Node>> _clampPending;
        std::unordered_set<osg::Node*> _clampInFlight;
        const osgEarth::Map* _workerMap = nullptr;

        std::mutex _resultMutex;
        std::deque<std::shared_ptr<ClampWorkResult>> _clampResults;

        std::thread _clampThread;
        std::atomic<bool> _clampRunning{false};

        // Terrain change detection -- fires invalidation when elevation data updates.
        std::atomic<unsigned> _clampGeneration{0};
        std::atomic<bool> _terrainDirty{false};
        osg::ref_ptr<TerrainCallback> _terrainCallback;
        bool _terrainCallbackInstalled = false;
    };
} }


#endif // OSGEARTH_CESIUM_TILESETNODE_H
