#ifndef OSGEARTH_CESIUM_SETTINGS_H
#define OSGEARTH_CESIUM_SETTINGS_H

#include "Export"
#include <cstdint>
#include <functional>
#include <string>

namespace osgEarth {
    namespace Cesium
    {
        OSGEARTHCESIUM_EXPORT std::string  getCesiumIonKey();
        void OSGEARTHCESIUM_EXPORT setCesiumIonKey(const std::string& key);

        /// 3D Tiles HTTP request lines ([3DTiles] on stderr). Off = no output; on = osg notify level.
        OSGEARTHCESIUM_EXPORT bool getLog3DTilesRequest();
        void OSGEARTHCESIUM_EXPORT setLog3DTilesRequest(bool enabled);

        /// Terrain tile request logging (GPU AssetAccessor OE_DEBUG, CPU quantized-mesh,
        /// cesium-native terrain messages on cesium_tileset). Off = no output; on = osg notify level.
        OSGEARTHCESIUM_EXPORT bool getLogTerrainRequest();
        void OSGEARTHCESIUM_EXPORT setLogTerrainRequest(bool enabled);

        /// Terrain imagery (Mapbox/VWorld/Naver/OWM raster overlay) transport logging
        /// (cesium_tileset imagery messages). Off = no output; on = spdlog default logger level.
        OSGEARTHCESIUM_EXPORT bool getLogTmsRequest();
        void OSGEARTHCESIUM_EXPORT setLogTmsRequest(bool enabled);

        /// HyperTerrain frame perf diag (scene cache, budget, drain) via OSG_NOTICE every ~5s.
        OSGEARTHCESIUM_EXPORT bool getLogHyperTerrainDiag();
        void OSGEARTHCESIUM_EXPORT setLogHyperTerrainDiag(bool enabled);

        /// RasterOverlayOptions::maximumSimultaneousTileLoads for TMS imagery (default 20).
        OSGEARTHCESIUM_EXPORT void setMaximumSimultaneousTmsLoads(uint32_t value);
        OSGEARTHCESIUM_EXPORT uint32_t getMaximumSimultaneousTmsLoads();

        /// Signal in-flight async tile loads to bail out. Cheap atomic; safe from any thread.
        OSGEARTHCESIUM_EXPORT void requestShutdown();
        OSGEARTHCESIUM_EXPORT bool isShuttingDown();

        OSGEARTHCESIUM_EXPORT void shutdown();

        using TileRebuildsPerFrameFn = std::function<double()>;
        OSGEARTHCESIUM_EXPORT void setTileRebuildsPerFrameProvider(TileRebuildsPerFrameFn fn);
        /// Fractional tile main-thread rebuild budget per frame (default 0.25 when no provider).
        OSGEARTHCESIUM_EXPORT double tileRebuildsPerFrameRate();

        OSGEARTHCESIUM_EXPORT void setTerrainRebuildsPerFrameProvider(TileRebuildsPerFrameFn fn);
        /// HyperTerrain Ion/TMS main-thread tile budget per frame (default 0.25 when no provider).
        OSGEARTHCESIUM_EXPORT double terrainRebuildsPerFrameRate();

        /// While HyperTerrain is streaming, defer user 3D Tiles loading (updateView/HTTP/slots).
        /// Does not hide already-loaded tiles; app layer visibility is unchanged.
        OSGEARTHCESIUM_EXPORT void setHyperTerrainLoadingActive(bool active);
        OSGEARTHCESIUM_EXPORT bool isHyperTerrainLoadingActive();

        /// Multiplier on user 3D Tiles rebuild rate while HyperTerrain is loading (default 0.05).
        OSGEARTHCESIUM_EXPORT void setUserTilesetRebuildScaleWhileTerrainLoads(double scale);
        OSGEARTHCESIUM_EXPORT double getUserTilesetRebuildScaleWhileTerrainLoads();

        /// Rebuild rate for CesiumTilesetNode (user layers), not HyperTerrainBridge.
        OSGEARTHCESIUM_EXPORT double userTilesetRebuildsPerFrameRate();
        /// Minimum main-thread tiles per pass for user tilesets (0 while terrain loads, else 4).
        OSGEARTHCESIUM_EXPORT uint32_t userTilesetMinMainThreadTilesPerPass();
        /// Max drain passes in CesiumTilesetNode cull while terrain is loading (default 2 vs 12).
        OSGEARTHCESIUM_EXPORT int userTilesetMaxDrainPassesWhileTerrainLoads();
    }
}


#endif // OSGEARTH_CESIUM_SETTINGS_H
