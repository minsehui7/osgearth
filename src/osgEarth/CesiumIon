    /**
     * Image layer connection to a Cesium ION server.
     */
    class OSGEARTH_EXPORT CesiumIonImageLayer : public ImageLayer
    {
    public: // serialization
        class OSGEARTH_EXPORT Options : public ImageLayer::Options
        {
        public:
            META_LayerOptions(osgEarth, Options, ImageLayer::Options);
            OE_OPTION(URI, server);
            OE_OPTION(std::string, assetId);
            OE_OPTION(std::string, token);
            static Config getMetadata();
            virtual Config getConfig() const;
        private:
            void fromConfig(const Config& conf);
        };

    public:
        META_Layer(osgEarth, CesiumIonImageLayer, Options, ImageLayer, CesiumIonImage);

    public:
        //! Base URL for requests
        void setServer(const URI& value);
        const URI& getServer() const;

        //! Asset identifier
        void setAssetId(const std::string& value);
        const std::string& getAssetId() const;

        //! Auth token
        void setToken(const std::string& value);
        const std::string& getToken() const;

    public: // Layer

        //! Establishes a connection to the TMS repository
        virtual Status openImplementation();

        virtual Status closeImplementation();

        //! Creates a raster image for the given tile key
        virtual GeoImage createImageImplementation(const TileKey& key, ProgressCallback* progress) const;

    protected: // Layer

        //! Called by constructors
        virtual void init();

    protected:

        //! Destructor
        virtual ~CesiumIonImageLayer() { }

    private:
        osg::ref_ptr< ImageLayer > _imageLayer;

        std::string _key;
    };

    /**
     * Elevation layer connection to a Cesium ION server.
     */
    struct CesiumTerrainAvailabilityRect
    {
        unsigned level = 0u;
        unsigned startX = 0u;
        unsigned startY = 0u;
        unsigned endX = 0u;
        unsigned endY = 0u;
    };

    class OSGEARTH_EXPORT CesiumIonTerrainMeshLayer : public TerrainMeshLayer
    {
    public: // serialization
        class OSGEARTH_EXPORT Options : public TerrainMeshLayer::Options
        {
        public:
            META_LayerOptions(osgEarth, Options, TerrainMeshLayer::Options);
            OE_OPTION(URI, server);
            OE_OPTION(std::string, assetId);
            OE_OPTION(std::string, token);
            static Config getMetadata();
            virtual Config getConfig() const;
        private:
            void fromConfig(const Config& conf);
        };

    public:
        META_Layer(osgEarth, CesiumIonTerrainMeshLayer, Options, TerrainMeshLayer, CesiumIonTerrainMesh);

    public:
        //! Base URL for requests
        void setServer(const URI& value);
        const URI& getServer() const;

        //! Asset identifier
        void setAssetId(const std::string& value);
        const std::string& getAssetId() const;

        //! Auth token
        void setToken(const std::string& value);
        const std::string& getToken() const;

        //! 서버 연결 오류 시 부모 타일 워크를 건너뛰고 즉시 빈 메시를 반환합니다.
        //! PriorityTerrainMeshLayer가 폴백 레이어가 존재하는 자식에 대해 자동으로 설정합니다.
        //! Default: false (기존 동작 — 부모 워크로 코어스 데이터 제공).
        void setFastFailOnServerError(bool value) { _fastFailOnServerError = value; }
        bool getFastFailOnServerError() const { return _fastFailOnServerError; }

        static void setLogTerrainHttpResponses(bool value);

    public: // Layer

        //! Establishes a connection to the TMS repository
        virtual Status openImplementation() override;

        virtual Status closeImplementation() override;
        virtual void dirty() override;

        virtual TileMesh createTileImplementation(
            const TileKey& key,
            ProgressCallback* progress) const override;

        bool isTerrainTileAvailable(const TileKey& key) const;

    protected: // Layer

        //! Called by constructors
        virtual void init();

    protected:

        //! Destructor
        virtual ~CesiumIonTerrainMeshLayer() { }

    private:

        URI _assetURI;
        std::string _key;
        bool _fastFailOnServerError = false;
        bool _hasAvailability = false;
        std::vector<CesiumTerrainAvailabilityRect> _availability;
        mutable LRUCache<std::string, TileMesh> _meshCache{ 256u };

        // 서킷 브레이커: 서버 오류 후 _kCircuitCooldown 동안 요청을 건너뜀.
        // fastFailOnServerError=true 일 때만 활성화.
        static constexpr int64_t _kCircuitCooldownNs = 30LL * 1'000'000'000LL; // 30 seconds
        mutable std::atomic<bool>    _circuitOpen{false};
        mutable std::atomic<int64_t> _circuitRetryNs{0}; // steady_clock nanoseconds
    };

